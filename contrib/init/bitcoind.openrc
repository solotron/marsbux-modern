#!/sbin/openrc-run

# backward compatibility for existing gentoo layout 
#
if [ -d "/var/lib/marsbux/.marsbux" ]; then
	marsbuxD_DEFAULT_DATADIR="/var/lib/marsbux/.marsbux"
else
	marsbuxD_DEFAULT_DATADIR="/var/lib/marsbuxd"
fi

marsbuxD_CONFIGFILE=${marsbuxD_CONFIGFILE:-/etc/marsbux/marsbux.conf}
marsbuxD_PIDDIR=${marsbuxD_PIDDIR:-/var/run/marsbuxd}
marsbuxD_PIDFILE=${marsbuxD_PIDFILE:-${marsbuxD_PIDDIR}/marsbuxd.pid}
marsbuxD_DATADIR=${marsbuxD_DATADIR:-${marsbuxD_DEFAULT_DATADIR}}
marsbuxD_USER=${marsbuxD_USER:-${marsbux_USER:-marsbux}}
marsbuxD_GROUP=${marsbuxD_GROUP:-marsbux}
marsbuxD_BIN=${marsbuxD_BIN:-/usr/bin/marsbuxd}
marsbuxD_NICE=${marsbuxD_NICE:-${NICELEVEL:-0}}
marsbuxD_OPTS="${marsbuxD_OPTS:-${marsbux_OPTS}}"

name="marsbux Core Daemon"
description="marsbux cryptocurrency P2P network daemon"

command="/usr/bin/marsbuxd"
command_args="-pid=\"${marsbuxD_PIDFILE}\" \
		-conf=\"${marsbuxD_CONFIGFILE}\" \
		-datadir=\"${marsbuxD_DATADIR}\" \
		-daemon \
		${marsbuxD_OPTS}"

required_files="${marsbuxD_CONFIGFILE}"
start_stop_daemon_args="-u ${marsbuxD_USER} \
			-N ${marsbuxD_NICE} -w 2000"
pidfile="${marsbuxD_PIDFILE}"

# The retry schedule to use when stopping the daemon. Could be either
# a timeout in seconds or multiple signal/timeout pairs (like
# "SIGKILL/180 SIGTERM/300")
retry="${marsbuxD_SIGTERM_TIMEOUT}"

depend() {
	need localmount net
}

# verify
# 1) that the datadir exists and is writable (or create it)
# 2) that a directory for the pid exists and is writable
# 3) ownership and permissions on the config file
start_pre() {
	checkpath \
	-d \
	--mode 0750 \
	--owner "${marsbuxD_USER}:${marsbuxD_GROUP}" \
	"${marsbuxD_DATADIR}"

	checkpath \
	-d \
	--mode 0755 \
	--owner "${marsbuxD_USER}:${marsbuxD_GROUP}" \
	"${marsbuxD_PIDDIR}"

	checkpath -f \
	-o ${marsbuxD_USER}:${marsbuxD_GROUP} \
	-m 0660 \
	${marsbuxD_CONFIGFILE}

	checkconfig || return 1
}

checkconfig()
{
	if ! grep -qs '^rpcpassword=' "${marsbuxD_CONFIGFILE}" ; then
		eerror ""
		eerror "ERROR: You must set a secure rpcpassword to run marsbuxd."
		eerror "The setting must appear in ${marsbuxD_CONFIGFILE}"
		eerror ""
		eerror "This password is security critical to securing wallets "
		eerror "and must not be the same as the rpcuser setting."
		eerror "You can generate a suitable random password using the following "
		eerror "command from the shell:"
		eerror ""
		eerror "bash -c 'tr -dc a-zA-Z0-9 < /dev/urandom | head -c32 && echo'"
		eerror ""
		eerror "It is recommended that you also set alertnotify so you are "
		eerror "notified of problems:"
		eerror ""
		eerror "ie: alertnotify=echo %%s | mail -s \"marsbux Alert\"" \
			"admin@foo.com"
		eerror ""
		return 1
	fi
}
